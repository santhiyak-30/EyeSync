# ==============================================================================
# EyeSync Screening Camp Platform - Environment Configuration Template
# Copy this file to .env for local deployment: cp .env.example .env
# ==============================================================================

# Backend Security
# Generate a high-entropy secret key in production: openssl rand -hex 32
EYESYNC_JWT_SECRET=change-this-in-local-development-secret-key-2026
EYESYNC_JWT_ALGORITHM=HS256
EYESYNC_TOKEN_EXPIRE_MINUTES=480

# Demo Credentials (for testing / prototype demonstration)
EYESYNC_DEMO_PASSWORD=EyeSync@2026!

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Frontend API URL
VITE_API_URL=http://localhost:8000
